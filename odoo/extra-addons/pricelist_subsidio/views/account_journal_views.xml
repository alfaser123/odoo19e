<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_journal_form_subsidio" model="ir.ui.view">
        <field name="name">account.journal.form.subsidio</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Aplicación contable de subsidios" invisible="type != 'sale'">
                    <field name="account_db_subs"/>
                    <field name="account_cr_subs"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_subsidio_lines" model="ir.ui.view">
        <field name="name">account.move.form.subsidio.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='aml_tab']//field[@name='name']" position="after">
                <field name="subsidio_pricelist_code" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
