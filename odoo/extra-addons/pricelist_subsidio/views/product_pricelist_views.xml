<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_pricelist_view_form_subsidio" model="ir.ui.view">
        <field name="name">product.pricelist.form.subsidio</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']/field[@name='company_id']" position="after">
                <field name="codigo_cat_subsidio"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_tree_subsidio" model="ir.ui.view">
        <field name="name">product.pricelist.list.subsidio</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="codigo_cat_subsidio" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
