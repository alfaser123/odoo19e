<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_excluded_rounding_method" model="ir.ui.view">
        <field name="name">account.tax.form.excluded.rounding.method</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_include_override']" position="after">
                <field name="excluded_rounding_method"
                       invisible="price_include_override != 'tax_excluded'"/>
            </xpath>
        </field>
    </record>
</odoo>
